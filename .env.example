# Copy to .env for local development. Never commit .env.

# dev | prod (prod disables Swagger UI and the OpenAPI schema)
ASTERAVIUM_ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
ASTERAVIUM_LOG_LEVEL=INFO
# Public repository URL; returned by GET /v1/about as the AGPL-3.0 source offer
ASTERAVIUM_SOURCE_URL=https://github.com/your-account/asteravium
# Set by the build pipeline
# ASTERAVIUM_COMMIT_SHA=
