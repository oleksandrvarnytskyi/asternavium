# Copy to .env for local development. Never commit .env.
# AWS credentials are not set here: export AWS_PROFILE in your shell instead.

# dev | prod (prod disables Swagger UI and the OpenAPI schema)
ASTERNAVIUM_ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
ASTERNAVIUM_LOG_LEVEL=INFO
# Public repository URL; returned by GET /v1/about as the AGPL-3.0 source offer
ASTERNAVIUM_SOURCE_URL=https://github.com/your-account/asternavium
# Set by the build pipeline
# ASTERNAVIUM_COMMIT_SHA=
# AWS region of the DynamoDB table (default eu-central-1)
#ASTERNAVIUM_AWS_REGION=eu-central-1
# DynamoDB table for profiles, persons, sessions and messages; created by make local-tables
ASTERNAVIUM_APP_TABLE_NAME=asternavium-local-app
